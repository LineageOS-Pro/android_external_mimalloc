package {
    default_applicable_licenses: ["external_mimalloc_license"],
}

license {
    name: "external_mimalloc_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "LICENSE",
    ],
}

// mimalloc (https://github.com/microsoft/mimalloc, main branch) built as a
// static library for use by bionic's native allocator dispatch (see
// bionic/libc/bionic/malloc_common.h).
//
// Deliberately NOT defining MI_MALLOC_OVERRIDE: bionic calls the "mi_" prefixed
// API directly and must keep ownership of the malloc/free symbols.
cc_library_static {
    name: "libmimalloc",
    defaults: ["linux_bionic_supported"],
    host_supported: false,
    // mimalloc is a pure C library. Without this, Soong links libc++_static
    // (the default STL) which depends on libc, creating a dependency cycle
    // because libc itself links libmimalloc.
    stl: "none",
    // Refuse the default system_shared_libs (which includes libc); mimalloc is
    // linked into libc itself and resolves libc symbols internally. Same as
    // libjemalloc5.
    system_shared_libs: [],

    // Provide the bionic headers (pthread.h, etc.) needed to compile mimalloc.
    header_libs: ["libc_headers"],

    srcs: [
        "src/alloc.c",
        "src/alloc-aligned.c",
        "src/alloc-posix.c",
        "src/arena.c",
        "src/bitmap.c",
        "src/heap.c",
        "src/init.c",
        "src/libc.c",
        "src/options.c",
        "src/os.c",
        "src/page.c",
        "src/page-map.c",
        "src/random.c",
        "src/sample-guarded.c",
        "src/sample-profile.c",
        "src/stats.c",
        "src/subproc.c",
        "src/theap.c",
        "src/threadlocal.c",
        "src/prim/prim.c",
        "src/prim/prim-tls.c",
        // init.c unconditionally calls _mi_pprof_profiler_init/_done (see
        // src/init.c).  With MI_PROFILE=0 this file compiles to empty stubs
        // (see src/profile/pprof.c's #if MI_PROFILE_USE_BUILTIN fallback),
        // so the device image does not pull in the real pprof profiler
        // (libunwind/execinfo backtraces, snapshot file writing) while
        // still satisfying the linker.
        "src/profile/pprof.c",
    ],

    cflags: [
        // Match the optimization level of the previous allocator (scudo is
        // built with -O3 as well); the default for platform cc modules is -O2.
        "-O3",
        // Do not let the compiler turn malloc-family calls into builtins.
        "-fno-builtin",
        // Keep the exported symbol surface limited to the "mi_" prefixed API.
        "-fvisibility=hidden",
        // mimalloc is linked into libc.so which always lives in the static TLS
        // block, so initial-exec is both valid and the fastest TLS model.
        "-ftls-model=initial-exec",
        "-Wno-unknown-pragmas",
        // mimalloc embeds __DATE__/__TIME__ in its build string; the platform
        // build enables -Werror=date-time, downgrade it to a warning.
        "-Wno-error=date-time",
        // Android's default allocator (scudo) zero-fills new allocations
        // (MALLOC_ZERO_CONTENTS) and vendor libraries rely on that behaviour;
        // mirror it for bionic integration.  This is the build-side switch that
        // activates the MI_ZERO_CONTENTS zero-fill path wired through
        // src/alloc.c / src/alloc-aligned.c; keep it in sync with those
        // consumers if the macro name ever changes.
        "-DMI_ZERO_CONTENTS=1",
        // MI_GUARDED is 0 by default (MI_DEBUG=0), but state it explicitly so
        // a future change cannot enable guard pages in the device image.  With
        // it off, the guarded-only sampling paths in sample-guarded.c and the
        // guarded init in theap.c stay inert.
        "-DMI_GUARDED=0",
        // Keep the pprof profiler compiled with MI_PROFILE at its default (1):
        // the dev3 refactor references _mi_pprof_profiler_init/_done from
        // init.c unconditionally, so pprof.c must always be linked into
        // libmimalloc.  With MI_PROFILE=1 pprof.c builds its baked-in branch
        // and mi_prim_backtrace falls back to the depth-0 stub on Android
        // (no execinfo.h/libunwind.h in the bionic toolchain), so no extra
        // link deps are pulled in.  Setting MI_PROFILE=0 instead hits a known
        // signature conflict between pprof.c's unconditional forward decl
        // (line ~107) and its !MI_PROFILE_USE_BUILTIN stub, which does not
        // compile under -Werror.
        "-DMI_PROFILE=1",
    ],

    export_include_dirs: ["include"],

    apex_available: [
        "com.android.runtime",
    ],
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    recovery_available: true,
    vendor_available: true,
    product_available: true,
    native_bridge_supported: true,
}
